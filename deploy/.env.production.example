# Chép thành deploy/.env.production trên VPS (chmod 600). Không commit file thật.

# Tên miền công khai, không có https://  (vd soidon.duckdns.org)
SITE_ADDRESS=
# Email nhận yêu cầu dữ liệu, hiện trên /privacy và /terms
SUPPORT_EMAIL=

# openssl rand -base64 24
POSTGRES_PASSWORD=
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32  — mất key này = mất mọi kết nối Gmail; sao lưu riêng, đừng để cạnh bản backup DB
TOKEN_ENC_KEY=

# Google Cloud Console → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sentry (để trống = tắt). Hai project: soidon-api (Node) và soidon-web (Next.js)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
